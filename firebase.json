{
  "hosting": {
    // dist/ is gitignored, so a deploy from a fresh checkout would otherwise
    // publish whatever happened to be there -- or nothing at all.
    "predeploy": ["npm --prefix \"$PROJECT_DIR\" run build"],
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      {
        // index.html must never be cached: it names the hashed asset bundles, so a
        // cached copy pins users to the previous deploy's JS for the cache lifetime.
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      },
      {
        // Asset filenames are content-hashed by Vite, so they're safe to cache forever.
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  },
  "functions": {
    // functions/lib is gitignored and package.json's main points into it, so
    // without this the CLI loads nothing, the discovery server never answers,
    // and the deploy fails as "Cannot determine backend specification.
    // Timeout after 10000" -- which names the symptom and not the cause.
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"],
    "source": "functions",
    "runtime": "nodejs20"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true }
  }
}
